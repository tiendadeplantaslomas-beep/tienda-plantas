// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  engineType      = "library"
  output          = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  }

// 1. Tabla de Usuarios y Roles para Login
model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  password  String   
  role      Role     @default(CLIENTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  sales     Sale[]   
}

enum Role {
  ADMIN
  CLIENTE
}

// 2. Catálogo / Inventario de Plantas e Insumos
model Product {
  id          String   @id @default(uuid())
  code        String   @unique // Ej: ART-001
  name        String   // Ej: Ficus Lyrata
  category    String   // Ej: Interior, Exterior, Substratos
  cost        Float    // Costo de compra
  price       Float    // Precio de venta
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  saleItems   SaleItem[]
}

// 3. Ventas (POS / CRM)
model Sale {
  id        String     @id @default(uuid())
  total     Float
  userId    String?
  user      User?      @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now())
  
  items     SaleItem[]
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}
