generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 1. Usuarios y Roles
model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(CLIENTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales     Sale[]
}

enum Role {
  ADMIN
  CLIENTE
}

// 2. Categorías con Margen de Ganancia
model Category {
  id            String    @id @default(uuid())
  name          String    @unique // Ej: Plantas de Interior, Sustratos
  defaultMargin Float     // Porcentaje (Ej: 100 para 100%, 120 para 120%)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products      Product[]
}

// 3. Catálogo / Inventario de Productos
model Product {
  id         String   @id @default(uuid())
  code       String   @unique // Ej: ART-001
  name       String   // Ej: Ficus Lyrata
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  cost       Float    // Costo de compra
  price      Float    // Precio de venta
  stock      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  saleItems  SaleItem[]
}

// 4. Ventas (POS / CRM)
model Sale {
  id        String     @id @default(uuid())
  total     Float
  userId    String?
  user      User?      @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now())

  items     SaleItem[]
}

model SaleItem {
  id        String   @id @default(uuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}