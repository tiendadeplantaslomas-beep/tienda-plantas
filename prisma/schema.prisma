datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS (OMNICANALIDAD Y MEDIOS DE PAGO)
// -------------------------------------------------------------
enum SalesChannel {
  MOSTRADOR // Venta en local físico / POS
  ONLINE    // Venta a través del e-commerce
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  DEBITO
  CREDITO
  MERCADOPAGO
}

// -------------------------------------------------------------
// CATEGORÍAS Y PROVEEDORES
// -------------------------------------------------------------
model Category {
  id            String    @id @default(cuid())
  name          String    @unique
  defaultMargin Float     @default(100)
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Supplier {
  id        String     @id @default(cuid())
  name      String     @unique
  address   String?    // Dirección o Link de Google Maps
  phone     String?
  notes     String?
  products  Product[]
  purchases Purchase[] // Relación con histórico de compras por lote
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// -------------------------------------------------------------
// PRODUCTOS E INVENTARIO
// -------------------------------------------------------------
model Product {
  id          String         @id @default(cuid())
  code        String         @unique
  name        String
  description String?        @db.Text // Descripción extendida para la Tienda Online
  imageUrl    String?        // Imagen principal para el e-commerce
  
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id])
  
  supplierId  String?
  supplier    Supplier?      @relation(fields: [supplierId], references: [id])

  cost        Int            // Costo base de compra
  otherCosts  Int            @default(0) // Flete, transporte, etc.
  price       Int            // Precio final al público
  margin      Float          @default(100)
  taxRate     Float          @default(21)
  
  // Gestión de existencias
  trackStock  Boolean        @default(true)
  stock       Int            @default(0)
  minStock    Int            @default(2) // Cantidad de advertencia / stock mínimo

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  saleItems     SaleItem[]
  purchaseItems PurchaseItem[] // Relación con ítems de compras
  movements     StockMovement[]
}

model StockMovement {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int
  type          String   // 'IN', 'OUT', 'ADJUSTMENT', 'PURCHASE', 'SALE_ONLINE', 'SALE_MOSTRADOR'
  notes         String?
  previousStock Int
  newStock      Int
  createdAt     DateTime @default(now())
}

// -------------------------------------------------------------
// COMPRAS EN LOTE (FACTURAS / REMITOS / PRESUPUESTOS)
// -------------------------------------------------------------
model Purchase {
  id              String         @id @default(cuid())
  docType         String         @default("FACTURA") // 'FACTURA', 'REMITO', 'PRESUPUESTO'
  docNumber       String?        // Número de comprobante
  date            DateTime       @default(now()) // Fecha de la compra / carga
  
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  
  subtotal        Int            // Suma de (costo * cantidad)
  otherCostsTotal Int            @default(0) // Total Flete / Gastos varios ($)
  total           Int            // subtotal + otros costos

  notes           String?
  createdAt       DateTime       @default(now())
  
  items           PurchaseItem[]
}

model PurchaseItem {
  id                 String   @id @default(cuid())
  purchaseId         String
  purchase           Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  
  productId          String
  product            Product  @relation(fields: [productId], references: [id])

  quantity           Int
  unitCost           Int      // Costo unitario base
  allocatedOtherCost Int      @default(0) // Flete por unidad
  finalUnitCost      Int      // unitCost + allocatedOtherCost
}

// -------------------------------------------------------------
// VENTAS Y DETALLE (OMNICANAL)
// -------------------------------------------------------------
model Sale {
  id            String        @id @default(cuid())
  channel       SalesChannel  @default(MOSTRADOR) // MOSTRADOR u ONLINE
  paymentMethod PaymentMethod @default(EFECTIVO)
  total         Int
  customerName  String?
  notes         String?
  
  // Relación opcional con cliente registrado en la web/local
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])

  createdAt     DateTime      @default(now())
  items         SaleItem[]
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Int
}

// -------------------------------------------------------------
// CLIENTES (REGISTRO WEB Y LOCAL)
// -------------------------------------------------------------
model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  address   String?
  sales     Sale[]   // Historial de compras del cliente
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}