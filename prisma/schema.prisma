datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS (OMNICANALIDAD Y MEDIOS DE PAGO)
// -------------------------------------------------------------
enum SalesChannel {
  POS
  MOSTRADOR 
  ONLINE    
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  DEBITO
  CREDITO
  MERCADOPAGO
}

// -------------------------------------------------------------
// CATEGORÍAS Y PROVEEDORES
// -------------------------------------------------------------
model Category {
  id            String    @id @default(cuid())
  name          String    @unique
  defaultMargin Float     @default(100)
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
}

// -------------------------------------------------------------
// PROVEEDORES
// -------------------------------------------------------------
model Supplier {
  id        String     @id @default(cuid())
  name      String     @unique
  address   String?    
  phone     String?
  notes     String?
  products  Product[]
  purchases Purchase[] 
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
}

// -------------------------------------------------------------
// PRODUCTOS E INVENTARIO
// -------------------------------------------------------------
model Product {
  id              String           @id @default(cuid())
  code            String           @unique
  sku             String?          @unique
  codigoBarras    String?          
  name            String
  description     String?          @db.Text 
  imageUrl        String?          @db.LongText
  
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
  
  supplierId      String?
  supplier        Supplier?        @relation(fields: [supplierId], references: [id])

  promotions      Promotion[]      @relation("PromotionProducts")

  // Costos y Precios
  cost            Int          
  otherCosts      Int              @default(0) // Desagregado de fletes/gastos por unidad
  price           Int              // Precio base o regular
  precioOferta    Int?             // Precio promocional o de oferta para la web
  margin          Float            @default(100)
  customMargin    Boolean          @default(false) 
  taxRate         Float            @default(21)
  
  // Control de Stock Separado (Físico vs Web)
  trackStock      Boolean          @default(true)
  stock           Int              @default(0) // Stock general / local del negocio
  stockWeb        Int              @default(0) // Stock exclusivo para la Tienda Online
  minStock        Int              @default(2) 
  
  // Atributos para la Ficha y Variantes (Estilo Vivero)
  tamano          String?          // Ej: "Nº 21", "3 Litros"
  color           String?          // Ej: "Terracota", "Verde", "Blanco"
  variantes       ProductVariant[] 
  
  destacado       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  
  saleItems       SaleItem[]
  purchaseItems   PurchaseItem[] 
  movements       StockMovement[]
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  sku          String?  @unique
  color        String?  
  tamano       String?  
  price        Int      
  stockWeb     Int      @default(0) 
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

// -------------------------------------------------------------
// MOVIMIENTOS DE MERCADERIAS
// -------------------------------------------------------------
model StockMovement {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int
  type          String   
  notes         String?
  previousStock Int
  newStock      Int
  createdAt     DateTime @default(now())
}

// -------------------------------------------------------------
// LOTE GLOBAL DE COMPRAS / SESIÓN DE SALIDA
// -------------------------------------------------------------
model PurchaseBatch {
  id               String     @id @default(cuid())
  date             DateTime   @default(now())
  freightCostTotal Int        @default(0) // Flete / Gastos globales del viaje
  notes            String?
  status           String     @default("PENDIENTE") // PENDIENTE (Stand-by) / RECIBIDO
  createdAt        DateTime   @default(now())

  purchases        Purchase[]
}

// -------------------------------------------------------------
// COMPRAS EN LOTE (COMPROBANTES INDIVIDUALES)
// -------------------------------------------------------------
model Purchase {
  id              String         @id @default(cuid())
  docType         String         @default("FACTURA") 
  docNumber       String?        
  date            DateTime       @default(now()) 
  
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  
  // Vínculo con el Lote Global de Salida
  batchId         String?
  batch           PurchaseBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  subtotal        Int            
  otherCostsTotal Int            @default(0) // Cuota de flete prorrateada para este comprobante
  total           Int            

  notes           String?
  createdAt       DateTime       @default(now())
  
  items           PurchaseItem[]
}

// -------------------------------------------------------------
// ÍTEMS DE COMPRA
// -------------------------------------------------------------
model PurchaseItem {
  id                 String   @id @default(cuid())
  purchaseId         String
  purchase           Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  
  productId          String
  product            Product  @relation(fields: [productId], references: [id])

  quantity           Int
  unitCost           Int      
  allocatedOtherCost Int      @default(0) 
  finalUnitCost      Int      
}

// -------------------------------------------------------------
// CLIENTES
// -------------------------------------------------------------
model Customer {
  id                 String   @id @default(cuid())
  name               String?
  email              String   @unique
  password_hash      String
  phone              String?
  address            String?
  dni_cuit           String?
  gender             String?  @default("neutral")
  image_url          String?  @db.LongText
  email_verified     Int      @default(0)
  verification_token String?
  origin             String   @default("tienda")
  created_at         DateTime @default(now())
  role               String   @default("cliente_web")

  sales              Sale[]
  payments           Payment[]
  customerPromotions CustomerPromotion[]
}

// -------------------------------------------------------------
// MOVIMIENTOS MANUALES DE CAJA
// -------------------------------------------------------------
model CashMovement {
  id          String   @id @default(cuid())
  type        String   
  description String
  amount      Int      
  createdAt   DateTime @default(now())
}

// -------------------------------------------------------------
// CIERRE DE CAJA
// -------------------------------------------------------------
model CashClosure {
  id            String   @id @default(cuid())
  date          String   @unique
  totalSales    Float    
  netCash       Float    
  closedAt      DateTime @default(now())
  closedBy      String?  
  notes         String?  
}

// -------------------------------------------------------------
// DATOS DE LA COMPAÑIA PARA LOS COMPROBANTES
// -------------------------------------------------------------
model CompanySettings {
  id              String   @id @default("default")
  tradeName       String   @default("TIENDA DE PLANTAS")
  legalName       String   @default("DANIEL ALBERTO URRACA")
  cuit            String   @default("20-XXXXXXXX-X")
  vatCondition    String   @default("MONOTRIBUTO")
  grossIncome     String   @default("20-XXXXXXXX-X")
  activityStart   String   @default("01/01/2024")
  address         String   @default("Lomas de Zamora, Buenos Aires")
  phone           String   @default("11-XXXX-XXXX")
  email           String   @default("contacto@tiendadeplantas.com")
  logoUrl         String?
  invoicePoint    Int      @default(1)
  receiptLegend   String   @default("DOCUMENTO NO VÁLIDO COMO FACTURA")
  defaultInvoiceC Boolean  @default(true)
  updatedAt       DateTime @default(now()) @updatedAt
}

// -------------------------------------------------------------
// VENTAS / PEDIDOS
// -------------------------------------------------------------
model Sale {
  id               String        @id @default(cuid())
  channel          SalesChannel  @default(MOSTRADOR)
  
  total            Int
  paidAmount       Int           @default(0)    
  pendingBalance   Int           @default(0)    
  paymentStatus    String        @default("PENDIENTE") 
  status           String        @default("REGISTRADO") 
  
  paymentMethod    PaymentMethod @default(EFECTIVO) 
  paymentReference String?       

  isPaid           Boolean       @default(false)
  isShipping       Boolean       @default(false)
  shippingAddress  String?       @db.Text
  
  invoiced         Boolean       @default(false)
  invoiceNumber    String?
  invoiceType      String?

  customerName     String?
  notes            String?
  
  customerId       String?
  customer         Customer?     @relation(fields: [customerId], references: [id])

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt

  items            SaleItem[]
  payments         Payment[]     
  claims           Claim[]
}

// -------------------------------------------------------------
// ÍTEMS DE LA VENTA
// -------------------------------------------------------------
model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Int
}

// -------------------------------------------------------------
// PAGOS
// -------------------------------------------------------------
model Payment {
  id            String        @id @default(cuid())
  saleId        String?
  sale          Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  amount        Int           
  paymentMethod PaymentMethod @default(EFECTIVO) 
  reference     String?       
  notes         String?
  createdAt     DateTime      @default(now())
}

// -------------------------------------------------------------
// PROMOCIONES Y CUPONERA
// -------------------------------------------------------------
model Promotion {
  id                 Int                 @id @default(autoincrement())
  titulo             String
  descripcion        String?
  badge              String?
  linkWhatsapp       String?
  imagenUrl          String?             @db.LongText
  activa             Boolean             @default(true)
  stock              Int                 
  desde              String?
  hasta              String?
  categoria          String?             
  customerPromotions CustomerPromotion[]
  productos          Product[]           @relation("PromotionProducts")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model CustomerPromotion {
  id           Int       @id @default(autoincrement())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  promotionId  Int
  promotion    Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  status       String    @default("activa")
  createdAt    DateTime  @default(now())
  redeemedAt   DateTime?
}

// -------------------------------------------------------------
// BANNERS Y CAMPAÑAS
// -------------------------------------------------------------
model Banner {
  id           Int      @id @default(autoincrement())
  seccion      String
  titulo       String?  @db.VarChar(255)
  subtitulo    String?  @db.Text 
  imagenUrl    String   @db.LongText
  link         String?  @db.VarChar(500)
  badge        String?  @db.VarChar(100)
  orden        Int      @default(0)
  activo       Boolean  @default(true)
  productosIds Json?    
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Campaign {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  imagenUrl   String?
  etiqueta    String?
  tipo        String   @default("verde")
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -------------------------------------------------------------
// USUARIOS DEL SISTEMA Y RESEÑAS
// -------------------------------------------------------------
model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String
  rol       String   @default("CAJERO") 
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resena {
  id           Int      @id @default(autoincrement())
  nombre       String?
  comentario   String?  @db.Text
  image_url    String?  @db.LongText  
  calificacion Int?
  activo       Boolean  @default(true)
  respuesta    String?  @db.Text 
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("resenas") 
}

model Claim {
  id          String    @id @default(cuid())
  saleId      String
  sale        Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  reason      String    
  resolution  String?   
  status      String    @default("ABIERTO") 
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}