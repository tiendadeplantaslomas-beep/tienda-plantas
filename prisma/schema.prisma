datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS (OMNICANALIDAD Y MEDIOS DE PAGO)
// -------------------------------------------------------------
enum SalesChannel {
  POS
  MOSTRADOR 
  ONLINE    
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  DEBITO
  CREDITO
  MERCADOPAGO
}

// -------------------------------------------------------------
// CATEGORÍAS Y PROVEEDORES
// -------------------------------------------------------------
model Category {
  id            String    @id @default(cuid())
  name          String    @unique
  defaultMargin Float     @default(100)
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
}

// -------------------------------------------------------------
// PROVEEDORES
// -------------------------------------------------------------
model Supplier {
  id        String     @id @default(cuid())
  name      String     @unique
  address   String?    
  phone     String?
  notes     String?
  products  Product[]
  purchases Purchase[] 
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
}

// -------------------------------------------------------------
// PRODUCTOS E INVENTARIO
// -------------------------------------------------------------
model Product {
  id          String         @id @default(cuid())
  code        String         @unique
  name        String
  description String?        @db.Text 
  imageUrl    String?        @db.LongText
  
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id])
  
  supplierId  String?
  supplier    Supplier?      @relation(fields: [supplierId], references: [id])

  cost        Int            
  otherCosts  Int            @default(0) 
  price       Int            
  margin      Float          @default(100)
  taxRate     Float          @default(21)
  
  trackStock  Boolean        @default(true)
  stock       Int            @default(0)
  minStock    Int            @default(2) 

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt

  saleItems     SaleItem[]
  purchaseItems PurchaseItem[] 
  movements     StockMovement[]
}

// -------------------------------------------------------------
// MOVIMIENTOS DE MERCADERIAS
// -------------------------------------------------------------
model StockMovement {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int
  type          String   
  notes         String?
  previousStock Int
  newStock      Int
  createdAt     DateTime @default(now())
}

// -------------------------------------------------------------
// COMPRAS EN LOTE
// -------------------------------------------------------------
model Purchase {
  id              String         @id @default(cuid())
  docType         String         @default("FACTURA") 
  docNumber       String?        
  date            DateTime       @default(now()) 
  
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  
  subtotal        Int            
  otherCostsTotal Int            @default(0) 
  total           Int            

  notes           String?
  createdAt       DateTime       @default(now())
  
  items           PurchaseItem[]
}

// -------------------------------------------------------------
// COMPRAS
// -------------------------------------------------------------
model PurchaseItem {
  id                 String   @id @default(cuid())
  purchaseId         String
  purchase           Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  
  productId          String
  product            Product  @relation(fields: [productId], references: [id])

  quantity           Int
  unitCost           Int      
  allocatedOtherCost Int      @default(0) 
  finalUnitCost      Int      
}


// -------------------------------------------------------------
// CLIENTES
// -------------------------------------------------------------
model Customer {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  password_hash      String
  phone              String
  address            String
  dni_cuit           String
  gender             String?   @default("neutral") // Agregamos esto
  image_url          String?   // Agregamos esto para la foto
  email_verified     Int       @default(0)
  verification_token String?
  origin             String    @default("tienda")
  created_at         DateTime  @default(now())
  sales              Sale[]
  payments           Payment[]
}

// -------------------------------------------------------------
// MOVIMIENTOS MANUALES DE CAJA
// -------------------------------------------------------------
model CashMovement {
  id          String   @id @default(cuid())
  type        String   
  description String
  amount      Int      
  createdAt   DateTime @default(now())
}

// -------------------------------------------------------------
// CIERRE DE CAJA
// -------------------------------------------------------------
model CashClosure {
  id            String   @id @default(cuid())
  date          String   @unique // Formato 'YYYY-MM-DD' para identificar el día exacto
  totalSales    Float    // Total vendido en el día
  netCash       Float    // Efectivo neto real en caja al cerrar
  closedAt      DateTime @default(now())
  closedBy      String?  // Usuario o cajero que realizó el cierre
  notes         String?  // Observaciones del arqueo físico vs sistema
}

// -------------------------------------------------------------
// DATOS DE LA COMPAÑIA PARA LOS COMPROBANTES
// -------------------------------------------------------------
model CompanySettings {
  id              String   @id @default("default")
  tradeName       String   @default("TIENDA DE PLANTAS")
  legalName       String   @default("DANIEL ALBERTO URRACA")
  cuit            String   @default("20-XXXXXXXX-X")
  vatCondition    String   @default("MONOTRIBUTO")
  grossIncome     String   @default("20-XXXXXXXX-X")
  activityStart   String   @default("01/01/2024")
  address         String   @default("Lomas de Zamora, Buenos Aires")
  phone           String   @default("11-XXXX-XXXX")
  email           String   @default("contacto@tiendadeplantas.com")
  logoUrl         String?
  invoicePoint    Int      @default(1)
  receiptLegend   String   @default("DOCUMENTO NO VÁLIDO COMO FACTURA")
  defaultInvoiceC Boolean  @default(true)
  updatedAt       DateTime @default(now()) @updatedAt
}

// -------------------------------------------------------------
// VENTAS / PEDIDOS (Limpio)
// -------------------------------------------------------------
model Sale {
  id               String        @id @default(cuid())
  channel          SalesChannel  @default(MOSTRADOR)
  
  total            Int
  paidAmount       Int           @default(0)    
  pendingBalance   Int           @default(0)    
  paymentStatus    String        @default("PENDIENTE") 
  status           String        @default("REGISTRADO") 
  
  // Volvemos a declarar las columnas que el frontend necesita
  paymentMethod    PaymentMethod @default(EFECTIVO) 
  paymentReference String?       

  isPaid           Boolean       @default(false)
  isShipping       Boolean       @default(false)
  shippingAddress  String?       @db.Text
  
  invoiced         Boolean       @default(false)
  invoiceNumber    String?
  invoiceType      String?

  customerName     String?
  notes            String?
  
  customerId       String?
  customer         Customer?     @relation(fields: [customerId], references: [id])

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt

  items            SaleItem[]
  payments         Payment[]     
}

// -------------------------------------------------------------
// ÍTEMS DE LA VENTA
// -------------------------------------------------------------
model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Int
}

// -------------------------------------------------------------
// PAGOS (El único lugar con método de pago)
// -------------------------------------------------------------
model Payment {
  id            String        @id @default(cuid())
  saleId        String?
  sale          Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  amount        Int           
  paymentMethod PaymentMethod @default(EFECTIVO) // <--- Debe coincidir aquí también
  reference     String?       
  notes         String?
  createdAt     DateTime      @default(now())
}